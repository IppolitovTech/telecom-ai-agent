# LLM provider switch: "openrouter" (free model, for testing) or "anthropic" (production)
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Cache dir for HuggingFace embedding model weights (mounted as a Docker volume
# so the model isn't re-downloaded on every container restart)
HF_HOME=/app/.cache/huggingface
